generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String    @unique
  email          String?   @unique
  emailVerified  DateTime?
  phoneNumber    String?   @unique
  carNumber      String?   @unique
  image          String?
  hashedPassword String?
  // key of the gate (customer) whose data the user works with; without it the user gets a personal demo sandbox
  tenant            String?
  // "admin" may see the activity journal of the gate; everybody else works without extra rights
  role              String?
  // when the personal demo sandbox was used last, null when the user has no sandbox database
  sandboxLastUsedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts Account[]
  calls    Call[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model GateUser {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  idInApi          String
  name             String
  phoneNumber      String
  carNumber        String[]
  apartmentNumber  String?
  image            String?
  additionalImages String[]
  isBlackListed    Boolean
  blackListedFrom  String
  blackListedTo    String

  calls Call[]

  @@unique([phoneNumber])
}

model Call {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  number          String
  time            String
  callerName      String?
  carNumber       String[]
  apartmentNumber String?
  image           String?
  isBlackListed   Boolean?
  blackListedFrom String?
  blackListedTo   String?
  secondsFullTime Int?
  // what the call ended with in terms of the gate (core CallOutcome). Calls stored before it existed
  // have only the raw provider codes below, their outcome is derived when they are read
  outcome         String?
  cause           Int?
  state           String?

  // userId String @db.ObjectId
  // user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gateUser   GateUser? @relation(fields: [gateUserId], references: [id])
  gateUserId String?   @db.ObjectId
  // user       User?     @relation(fields: [userId], references: [id])
  // userId     String?   @db.ObjectId
  User       User?     @relation(fields: [userId], references: [id])
  userId     String?   @db.ObjectId

  // one phone can not make two calls in the same second: the guarantee against storing a call twice.
  // time comes first, so the same index serves every query by a period.
  // Created in the production database with a targeted createIndexes command, never with `prisma db push`.
  @@unique([time, number])
}

// What a penalty was for: the violations of the apartment since its previous penalty, see core PenaltyReason
type PenaltyReasonRecord {
  since            String
  overstays        Int
  openVisits       Int
  overstayMinutes  Int
  minutesOverLimit Int
}

// A penalty of an apartment (or of a caller without an apartment): its phones may not open the gate
// for a while. Kept apart from GateUser: removing a gate user must not erase the history of penalties.
model Penalty {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  // the apartment number or, without an apartment, the phone number
  subjectKey      String
  apartmentNumber String?
  phoneNumbers    String[]
  // 'YYYY-MM-DD HH:mm:ss', the local time of the gate
  from            String
  until           String
  imposedById     String?
  imposedByName   String?
  // the ready-made ground the operator chose (core PenaltyGround) and what they wrote when blocking
  ground          String?
  comment         String?
  reason          PenaltyReasonRecord?
  liftedAt        String?
  // 'manually' | 'expired'
  liftedHow       String?
  // why it was lifted: core PenaltyLiftGround and the words of the operator
  liftedGround    String?
  liftedComment   String?
  // 'recorded' | 'restoredFromCalls'
  source          String
  createdAt       DateTime @default(now())

  @@index([from])
  @@index([subjectKey, from])
}

// A day ('YYYY-MM-DD' is the id) whose calls were loaded from the telephony after the day was over:
// the day is complete, it is read from this database and the telephony is not asked about it again
model CallsDaySync {
  id       String   @id @map("_id")
  syncedAt DateTime
}

model LastCallsRequestFromApi {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  time String
}

model lastGateUserRequestFromApi {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  time String
}

// Journal of what the operators and the scheduled jobs did with the gate users.
// Lives in the database of the gate, so every customer and every demo sandbox has its own journal.
// The newest records are read by _id, which grows with time: no extra index is needed.
model ActivityEvent {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  // ISO 8601, UTC
  at        String
  actorId   String
  actorName String
  action    String
  // snapshots of the gate users the action was about
  subjects  Json
  details   Json
}

// When the accounts signed in and which pages they opened. High volume, short life:
// a TTL index on `at` (created by the adapter, see prismaAccessLog.ts) removes records after 30 days.
model AccessEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  // a real date, not a string: MongoDB expires documents only by a date field
  at        DateTime
  actorId   String
  actorName String
  // "signIn" | "pageView"
  kind      String
  path      String?
  ip        String?
  device    String?
}
