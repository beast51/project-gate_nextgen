{
  "name": "project-gate_nextgen",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run lint && next build --webpack",
    "start": "next start",
    "lint": "eslint --ext .ts,.tsx app core infrastructure contracts proxy.ts",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 -c ./config/storybook",
    "build-storybook": "storybook build -c ./config/storybook",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.0",
    "@fontsource/material-icons": "^5.0.7",
    "@mui/material": "^5.18.0",
    "@mui/x-date-pickers": "^7.29.4",
    "@prisma/client": "5.11.0",
    "bcrypt": "^5.1.0",
    "classnames": "^2.3.2",
    "cloudinary": "^1.41.0",
    "eslint": "^8.51.0",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.43",
    "next": "16.3.5",
    "next-auth": "^4.24.15",
    "next-cloudinary": "^6.19.3",
    "next-i18n-router": "4.1.2",
    "next-pwa": "^5.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.47.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^4.11.0",
    "react-intl": "^7.1.11",
    "swiper": "^11.0.3",
    "swr": "^2.2.4"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/nextjs": "^10.6.0",
    "@types/bcrypt": "^5.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-storybook": "^10.6.0",
    "prisma": "5.11.0",
    "sass": "1.72.0",
    "storybook": "^10.6.0",
    "typescript": "^5.2.2",
    "vite": "^7",
    "vitest": "^5.0.1"
  },
  "eslintConfig": {
    "root": true,
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "plugins": [
      "react-hooks"
    ],
    "extends": [
      "plugin:storybook/recommended"
    ],
    "overrides": [
      {
        "files": [
          "contracts/**/*.ts"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "patterns": [
                {
                  "group": [
                    "*",
                    "!.",
                    "!./*"
                  ],
                  "message": "contracts/ is the HTTP contract shared by the front end and the back end, it must not depend on anything"
                }
              ]
            }
          ]
        }
      },
      {
        "files": [
          "core/**/*.ts"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "paths": [
                "next",
                "next-auth",
                "react",
                "react-dom"
              ],
              "patterns": [
                "next/*",
                "next-auth/*",
                "react/*",
                "react-dom/*",
                "@prisma/*",
                "@/app/*",
                "@/appLayer/*",
                "@/pagesLayer/*",
                "@/widgetsLayer/*",
                "@/featuresLayer/*",
                "@/entitiesLayer/*",
                "@/sharedLayer/*",
                "@/infrastructure/*",
                "**/infrastructure/*",
                "**/app/*"
              ]
            }
          ]
        }
      },
      {
        "files": [
          "infrastructure/**/*.ts"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "paths": [
                "next",
                "next-auth",
                "react",
                "react-dom"
              ],
              "patterns": [
                "next/*",
                "next-auth/*",
                "react/*",
                "react-dom/*",
                "@/app/*",
                "@/appLayer/*",
                "@/pagesLayer/*",
                "@/widgetsLayer/*",
                "@/featuresLayer/*",
                "@/entitiesLayer/*",
                "@/sharedLayer/*",
                "**/app/*"
              ]
            }
          ]
        }
      },
      {
        "files": [
          "app/pagesLayer/**/*.{ts,tsx}",
          "app/widgetsLayer/**/*.{ts,tsx}",
          "app/featuresLayer/**/*.{ts,tsx}",
          "app/entitiesLayer/**/*.{ts,tsx}",
          "app/sharedLayer/**/*.{ts,tsx}",
          "app/(pages)/**/*.{ts,tsx}"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "patterns": [
                {
                  "group": [
                    "@/core/*",
                    "@/infrastructure/*",
                    "@/appLayer/libs/*",
                    "@/appLayer/api/*",
                    "@prisma/*",
                    "**/core/*",
                    "**/infrastructure/*",
                    "**/(appLayer)/libs/*",
                    "**/(appLayer)/api/*"
                  ],
                  "message": "The front end knows only contracts/ and HTTP (sharedLayer/api). It must not import back-end code."
                },
                {
                  "group": [
                    "next",
                    "next/*",
                    "next-auth",
                    "next-auth/*",
                    "next-i18n-router",
                    "next-i18n-router/*",
                    "next-cloudinary"
                  ],
                  "message": "Use the wrappers from sharedLayer/framework: it is the only place of the UI that knows the framework."
                },
                {
                  "group": [
                    "axios"
                  ],
                  "message": "Use the API client from sharedLayer/api."
                }
              ]
            }
          ],
          "no-restricted-syntax": [
            "error",
            {
              "selector": "CallExpression[callee.name='fetch']",
              "message": "Use the API client from sharedLayer/api."
            }
          ]
        }
      },
      {
        "files": [
          "app/sharedLayer/framework/**/*.{ts,tsx}",
          "app/(pages)/**/*.{ts,tsx}"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "patterns": [
                {
                  "group": [
                    "@/core/*",
                    "@/infrastructure/*",
                    "@/appLayer/libs/*",
                    "@/appLayer/api/*",
                    "@prisma/*",
                    "**/core/*",
                    "**/infrastructure/*",
                    "**/(appLayer)/libs/*",
                    "**/(appLayer)/api/*"
                  ],
                  "message": "The front end knows only contracts/ and HTTP (sharedLayer/api). It must not import back-end code."
                },
                {
                  "group": [
                    "axios"
                  ],
                  "message": "Use the API client from sharedLayer/api."
                }
              ]
            }
          ]
        }
      },
      {
        "files": [
          "app/sharedLayer/api/**/*.ts",
          "app/sharedLayer/framework/serverApi.ts"
        ],
        "rules": {
          "no-restricted-syntax": "off"
        }
      },
      {
        "files": [
          "app/(appLayer)/api/**/*.ts"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "patterns": [
                {
                  "group": [
                    "@/infrastructure/*",
                    "**/infrastructure/*"
                  ],
                  "message": "Route handlers get use cases from libs/container.ts. Only the composition root knows the adapters (database, telephony provider)."
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
