{
  "name": "project-gate_nextgen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 -c ./config/storybook",
    "build-storybook": "storybook build -c ./config/storybook",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@emotion/react": "latest",
    "@emotion/styled": "latest",
    "@fontsource/material-icons": "^5.0.7",
    "@mui/material": "latest",
    "@mui/styled-engine-sc": "^5.12.0",
    "@mui/x-data-grid": "^6.16.2",
    "@mui/x-date-pickers": "latest",
    "@next-auth/prisma-adapter": "^1.0.6",
    "@prisma/client": "^5.5.2",
    "axios": "^1.5.1",
    "bcrypt": "^5.1.0",
    "classnames": "^2.3.2",
    "cloudinary": "^1.41.0",
    "eslint": "^8.51.0",
    "eslint-config-next": "^13.4.19",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.43",
    "next": "14.1.3",
    "next-auth": "^4.23.2",
    "next-cloudinary": "^4.28.0",
    "next-i18n-router": "^4.0.0",
    "next-pwa": "^5.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.47.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^4.11.0",
    "react-intl": "^6.4.7",
    "swiper": "^11.0.3",
    "swr": "^2.2.4"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^7.5.2",
    "@storybook/addon-interactions": "^7.5.2",
    "@storybook/addon-links": "^7.5.2",
    "@storybook/addon-mdx-gfm": "^7.5.2",
    "@storybook/addon-onboarding": "^1.0.8",
    "@storybook/blocks": "^7.5.2",
    "@storybook/nextjs": "^7.5.2",
    "@storybook/react": "^7.5.2",
    "@storybook/testing-library": "^0.2.2",
    "@types/bcrypt": "^5.0.0",
    "@types/node": "^20.5.9",
    "@types/react": "^18.2.22",
    "@types/react-dom": "^18.2.7",
    "@types/react-intl": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@typescript-eslint/parser": "^6.8.0",
    "eslint-plugin-storybook": "^0.6.15",
    "prisma": "^5.5.2",
    "sass": "^1.66.1",
    "storybook": "^7.5.2",
    "typescript": "^5.2.2",
    "vite": "^7",
    "vitest": "^5.0.1"
  },
  "eslintConfig": {
    "root": true,
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "plugins": [
      "react-hooks"
    ],
    "extends": [
      "plugin:storybook/recommended"
    ],
    "overrides": [
      {
        "files": [
          "contracts/**/*.ts"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "patterns": [
                {
                  "group": [
                    "*",
                    "!.",
                    "!./*"
                  ],
                  "message": "contracts/ is the HTTP contract shared by the front end and the back end, it must not depend on anything"
                }
              ]
            }
          ]
        }
      },
      {
        "files": [
          "core/**/*.ts"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "paths": [
                "next",
                "next-auth",
                "react",
                "react-dom"
              ],
              "patterns": [
                "next/*",
                "next-auth/*",
                "react/*",
                "react-dom/*",
                "@prisma/*",
                "@/app/*",
                "@/appLayer/*",
                "@/pagesLayer/*",
                "@/widgetsLayer/*",
                "@/featuresLayer/*",
                "@/entitiesLayer/*",
                "@/sharedLayer/*",
                "@/infrastructure/*",
                "**/infrastructure/*",
                "**/app/*"
              ]
            }
          ]
        }
      },
      {
        "files": [
          "infrastructure/**/*.ts"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "paths": [
                "next",
                "next-auth",
                "react",
                "react-dom"
              ],
              "patterns": [
                "next/*",
                "next-auth/*",
                "react/*",
                "react-dom/*",
                "@/app/*",
                "@/appLayer/*",
                "@/pagesLayer/*",
                "@/widgetsLayer/*",
                "@/featuresLayer/*",
                "@/entitiesLayer/*",
                "@/sharedLayer/*",
                "**/app/*"
              ]
            }
          ]
        }
      },
      {
        "files": [
          "app/pagesLayer/**/*.{ts,tsx}",
          "app/widgetsLayer/**/*.{ts,tsx}",
          "app/featuresLayer/**/*.{ts,tsx}",
          "app/entitiesLayer/**/*.{ts,tsx}",
          "app/sharedLayer/**/*.{ts,tsx}",
          "app/(pages)/**/*.{ts,tsx}"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "patterns": [
                {
                  "group": [
                    "@/core/*",
                    "@/infrastructure/*",
                    "@/appLayer/libs/*",
                    "@/appLayer/api/*",
                    "@prisma/*",
                    "**/core/*",
                    "**/infrastructure/*",
                    "**/(appLayer)/libs/*",
                    "**/(appLayer)/api/*"
                  ],
                  "message": "The front end knows only contracts/ and HTTP (sharedLayer/api). It must not import back-end code."
                },
                {
                  "group": [
                    "next",
                    "next/*",
                    "next-auth",
                    "next-auth/*",
                    "next-i18n-router",
                    "next-i18n-router/*",
                    "next-cloudinary"
                  ],
                  "message": "Use the wrappers from sharedLayer/framework: it is the only place of the UI that knows the framework."
                },
                {
                  "group": [
                    "axios"
                  ],
                  "message": "Use the API client from sharedLayer/api."
                }
              ]
            }
          ],
          "no-restricted-syntax": [
            "error",
            {
              "selector": "CallExpression[callee.name='fetch']",
              "message": "Use the API client from sharedLayer/api."
            }
          ]
        }
      },
      {
        "files": [
          "app/sharedLayer/framework/**/*.{ts,tsx}",
          "app/(pages)/**/*.{ts,tsx}"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "patterns": [
                {
                  "group": [
                    "@/core/*",
                    "@/infrastructure/*",
                    "@/appLayer/libs/*",
                    "@/appLayer/api/*",
                    "@prisma/*",
                    "**/core/*",
                    "**/infrastructure/*",
                    "**/(appLayer)/libs/*",
                    "**/(appLayer)/api/*"
                  ],
                  "message": "The front end knows only contracts/ and HTTP (sharedLayer/api). It must not import back-end code."
                },
                {
                  "group": [
                    "axios"
                  ],
                  "message": "Use the API client from sharedLayer/api."
                }
              ]
            }
          ]
        }
      },
      {
        "files": [
          "app/sharedLayer/api/**/*.ts",
          "app/sharedLayer/framework/serverApi.ts"
        ],
        "rules": {
          "no-restricted-syntax": "off"
        }
      },
      {
        "files": [
          "app/(appLayer)/api/**/*.ts"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "patterns": [
                {
                  "group": [
                    "@/infrastructure/*",
                    "**/infrastructure/*"
                  ],
                  "message": "Route handlers get use cases from libs/container.ts. Only the composition root knows the adapters (database, telephony provider)."
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "resolutions": {
    "jackspeak": "2.1.1"
  }
}
